# Environment Configuration Template (NEVER commit real secrets)
# In production, secrets are loaded automatically from Google Cloud Secret Manager.

# Google Cloud Project & Region
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Secret Manager Secret Names (values stored in GCP Secret Manager, not here)
GEMINI_API_KEY_SECRET_NAME=assessment-agent-gemini-api-key
GITHUB_TOKEN_SECRET_NAME=assessment-agent-github-readonly-token

# Strategic Model Routing (Flash for fast triage/evals, Pro for deep architectural review)
ASSESSMENT_FAST_MODEL=gemini-2.5-flash
ASSESSMENT_REASONING_MODEL=gemini-2.5-pro

# Persistence & Memory
ASSESSMENT_SESSION_DB_URL=sqlite+aiosqlite:///./data/sessions.db
ASSESSMENT_HISTORY_DB_PATH=./data/assessment_history.db
VERTEX_AGENT_ENGINE_ID=

# Security, PII Redaction & Observability
ENABLE_CLOUD_DLP=FALSE
ENABLE_CLOUD_TRACE=FALSE
MODEL_ARMOR_TEMPLATE_ID=
DEFAULT_REPORT_LANGUAGE=es
